# Example environment for openai-completions-termux (peers-only serving).
# Copy to .env and fill in. Every value is OPTIONAL:
#   - without the keys, the committed config.d/ still loads (peers are just
#     skipped / have no apiKey), and
#   - LISTEN defaults to :8080 if omitted.
# These are real environment variables: generate.sh passes them to the node
# generators, and run.sh loads them so the native llama-swap binary can resolve
# the ${env.*} references in config.d/ from its environment.
# (# comments are ignored by both run.sh and the node generators.)

# llama-swap server auth — pi (the client) must send this as its api key.
LLAMASWAP_API_KEY=

# Cloud peer provider keys (enable the corresponding peer in config.d/).
OPENROUTER_API_KEY=
OPENCODE_API_KEY=   # unified key for both the OpenCode Zen and Go peers

# Providers to skip when generating config.d/ (space/comma separated).
DISABLED_PROVIDERS=google-free

# Listen address for the llama-swap server.
LISTEN=:8080
