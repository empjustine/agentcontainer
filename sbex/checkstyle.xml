<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  The Java style gate (docs/d219). Deliberately NOT google_checks/sun_checks:
  those reformat opinions (tabs, indentation, javadoc on every method) are not
  this tree's, and a gate that reports 1,300 findings on a clean unit teaches
  nothing. The set below is the structural half of SonarQube's Java style rules
  — imports, braces, equality, switch shape, empty blocks — that a reviewer
  would otherwise have to spot by hand.

  Formatting (tabs, line wrapping) is out of scope on purpose: there is no
  formatter in this repo's Java build, and adding one would be a separate
  decision (docs/d219 records the rejected google-java-format path).
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="tabWidth" value="4"/>
  <property name="severity" value="warning"/>

  <module name="NewlineAtEndOfFile"/>
  <module name="LineLength">
    <property name="max" value="160"/>
  </module>

  <module name="TreeWalker">
    <module name="AvoidStarImport"/>
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>
    <module name="IllegalImport">
      <property name="illegalPkgs" value="sun,com.sun"/>
    </module>

    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignored"/>
    </module>
    <module name="EqualsHashCode"/>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
    <module name="OneStatementPerLine"/>
    <module name="MultipleVariableDeclarations"/>
    <module name="NeedBraces"/>
    <module name="UpperEll"/>
    <module name="ArrayTypeStyle"/>
    <module name="ModifierOrder"/>
    <module name="RedundantModifier"/>
    <module name="StringLiteralEquality"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="DefaultComesLast"/>
    <module name="EmptyStatement"/>
    <module name="InnerAssignment"/>
  </module>
</module>
