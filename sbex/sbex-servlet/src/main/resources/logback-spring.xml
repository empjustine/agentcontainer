<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- The json profile is the container contract: one JSON object per line,
	so the log driver ships machine-readable events with no agent and no
	second pipeline (sbex/README.md). -->
	<springProfile name="json">
		<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
			<encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
		</appender>
	</springProfile>
	<springProfile name="!json">
		<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
			<encoder>
				<pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
			</encoder>
		</appender>
	</springProfile>
	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
	</root>
</configuration>
