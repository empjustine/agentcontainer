// Biome config. Formatter defaults (tabs, 80 cols) already match the tree; the
// only explicit setting is import organizing, which the repo relies on.
//
// NOTE: comments require the .jsonc filename — Biome 2.x refuses to parse
// comments in a plain biome.json (and a config that fails to parse silently
// drops every setting below, including files.ignore).
//
// `files.includes` is load-bearing, not tidiness: Biome 2.x uses `includes`
// with `!`-negated globs (the old `files.ignore` key no longer exists).
//   - .pi/, .vscode/ and .thinkrail/ are tool-owned dirs, not repo source.
//   - the vendored models.dev catalog, the VRAM-fit data file and the HF
//     manifests are fetched/derived data, not hand-maintained source.
//   - coding-agent/models.json, model-*.json, pi-synthetic/models.json and
//     pi-synthetic/models.js are WRITTEN by their generators
//     (JSON.stringify(…, null, 2)) — formatting them here would only be undone
//     by the next generate run, and would show up as churn in the artifact a
//     regeneration is supposed to be reviewed by.
{
	"files": {
		"includes": [
			"**",
			"!.pi",
			"!.vscode",
			"!.thinkrail",
			"!opencode_share",
			"!**/models.dev.api.json",
			"!**/gguf-vram-fit-estimates.data.json",
			"!**/catwalk-facts.json",
			"!lib/hf-manifests",
			"!coding-agent/models.json",
			"!coding-agent/model-*.json",
			// pi-synthetic's pair of generated artifacts (d096): the pi
			// models.json-shaped provider block and the extension's model seed.
			"!pi-synthetic/models.json",
			"!pi-synthetic/models.js",
			// pi-cline-pass's generated pair, same reasoning (d040).
			"!pi-cline-pass/models.json",
			"!pi-cline-pass/models.js",
			"!coding-agent/hyper-facts.json",
			"!llm-reverse-proxy/llm-reverse-proxy.json",
			// same reasoning, .jsonc extension: written by
			// generate-opencode.mjs
			"!coding-agent/opencode.jsonc"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
