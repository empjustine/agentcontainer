# Containerfile — multi-stage build for estige.
#
# Stage 1 compiles the static binary (CGO off — the result is fully
# static); stage 2 is `scratch`, so the FINAL image is pulled from no
# registry at all. The only remote FROM in this file is golang:1.27 on
# docker.io — deliberately: environments that block non-docker.io
# registries can never pull the gcr.io distroless base this replaced,
# while scratch resolves locally and a static binary needs nothing else.
#
# The CA certificate bundle rides along from the builder: both TLS legs
# verify against it and neither may ever skip verification — upstream
# certificates (modes A/D) and the relay node verifying the Funnel
# `*.ts.net` certificate (VPN-R28, VPN-R55; docs/d073). Final image is
# ~7.5 MB: one binary plus that bundle.
#
# The whole package is copied, not a hand-listed subset: the tunnel (mode D) added five
# source files, and a stale COPY list builds a subset that no longer
# compiles (go build ignores *_test.go, so no test code enters the image).
#
# The image ENTRYPOINT is the binary itself; the operator passes -mode as the
# container command (`podman run ... -mode exit`). Configuration is env-only:
# the bind is env PORT (docs/d110) and the egress policy is VPN_TUNNEL_EGRESS
# (docs/d108 removed the last config file, so nothing is mounted for the binary
# to read).
FROM docker.io/library/golang:1.27 AS build
WORKDIR /src
COPY go.mod *.go ./
# The one version spelling (packaging/VERSION) also stamps the image binary, so
# `estige -version` inside the container matches the packages.
COPY packaging/VERSION ./VERSION
# GOTOOLCHAIN=local: a go.mod/toolchain bump that outruns this builder must
# FAIL the build loudly — cmd/go's automatic toolchain download is the one
# build-time path that downloads AND executes code, and the only toolchain
# we trust on this build is the one this image already contains.
ENV GOTOOLCHAIN=local
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags="-s -w -X main.version=$(cat VERSION)" -o /out/estige .

# Numeric USER because scratch has no /etc/passwd: the static binary makes no
# os/user lookups, and 65532 is the distroless "nonroot" uid this image replaces.
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/estige /estige
USER 65532:65532
ENTRYPOINT ["/estige"]
