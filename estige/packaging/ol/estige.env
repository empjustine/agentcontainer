# estige exit node — Oracle Linux package env file.
#
# Read by systemd's EnvironmentFile= for estige.service. The binary reads no
# file; this is the service manager's env chain. Mode 0600 root:root.
#
# NOTHING SECRET LIVES HERE (d236). The host identity, the admitted relays and
# the egress policy are the store under $XDG_DATA_HOME/estige; the unit sets
# that to /var/lib/estige/.local/share and creates /var/lib/estige as the
# service's StateDirectory. Provision it once, as the estige user:
#
#   estige keygen -principal exit-home       # this host's key + certificate
#   estige public -f /var/lib/estige/.local/share/estige/prv/exit-home.der
#   estige key check                         # validate before enabling
#
# exit.json carries the admitted relays and the egress policy:
#   {"relays":[{"name":"relay_bazzite","public":"<cert>"}],
#    "egress":{"allowCidrs":["10.0.0.0/8"],"ports":[443]}}
#
# Bind (docs/d110): a bare port number, unset = 8080 on all interfaces.
# The packaged unit has no CAP_NET_BIND_SERVICE; a port below 1024 needs an
# operator drop-in that adds it (README).
# PORT=8080
#
# A second, capped-edge listener (docs/d222), same shape as PORT.
# PORT_CLOUDFLARE=8081
