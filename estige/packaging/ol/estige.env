# estige exit node — Oracle Linux package env file.
#
# Read by systemd's EnvironmentFile= for estige.service. The binary reads no
# file; this is the service manager's env chain. Mode 0600 root:root.
#
# Arm the tunnel (docs/d084/d085): a JSON object {"<id>": "<token>"}.
# Without it the exit node refuses to start (the kill-switch law, docs/d084).
# Single-quote JSON and any value carrying shell metacharacters.
# VPN_OPERATOR_KEYS='{"<id>":"<token>"}'
#
# Bind (docs/d110): a bare port number, unset = 8080 on all interfaces.
# The packaged unit has no CAP_NET_BIND_SERVICE; a port below 1024 needs an
# operator drop-in that adds it (README).
# PORT=8080
#
# Egress opt-ins (VPN-R38): JSON {"allowCidrs": [...], "ports": [...]}.
# Unset = the requirement's defaults (deny RFC 1918/metadata/loopback,
# allow 80/443). Single-quote it: a bare JSON value loses its quotes in sh.
# VPN_TUNNEL_EGRESS='{"allowCidrs":["10.0.0.0/8"],"ports":[443]}'
