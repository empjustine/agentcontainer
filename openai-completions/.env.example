#!/bin/sh
# OPENAI-COMPLETIONS ENV — the peers-only serving layout.
#
# DOCUMENTATION ONLY — NO SCRIPT IN THIS REPO READS THIS FILE.
#
# `load_secrets` (../container-tool.sh) is the single source of these values,
# and it has exactly two inputs:
#
#   1. the CALLER'S ENVIRONMENT (keys already exported, or SECRETS_ASSUME=1),
#   2. Infisical — one `infisical secrets --output=dotenv` per call, injected
#      into the environment IN MEMORY (the dotenv text is only the CLI's wire
#      format; it is never written to a file).
#
# The file-based loaders are gone: no `.env`, no `$ENV_FILE`, no vault cache
# file.  So there is nothing to copy this file TO — read it as the list of key
# names this layout expects to find already exported in the process
# environment.  The values below are empty on purpose; nothing consumes the
# empty strings.
#
# PEERS-ONLY MEANS: no LLAMACPP_BASE_URL / LLAMA_API_BASE_URL (there is no
# local llama.cpp server to point at) and no local `models` layer in config.d/
# — see generate.sh, which gates 10-local-llm-inference.yaml on a container
# backend + GPU devices.  Local GGUF args are emitted only on GPU-capable
# container hosts, by generate-local-llm-models.yaml.mjs.
#
# Key names are PLAIN and UN-PREFIXED, because they are consumed server-side:
# gen-lib.mjs reads exactly these names, and the generated config.d/ references
# them as ${env.*}, which llama-swap resolves from its own process environment
# at load time (an unset ${env.*} ABORTS the whole config load).  The old
# `__`-prefixed convention (which existed to hide keys from pi's provider
# auto-detection) is gone — pi is the *client* of llama-swap and never sees
# these keys, only the llama-swap bearer key below.  See docs/d019.
#
# The base URLs below are HARDCODED in gen-lib.mjs (PROVIDERS) and are NOT
# env-overridable; this table documents them, it does not configure them.
#
#   | Provider              | API key env         | Base URL                          |
#   |-----------------------|---------------------|-----------------------------------|
#   | OpenRouter            | OPENROUTER_API_KEY  | https://openrouter.ai/api/v1      |
#   | OpenCode Zen          | OPENCODE_API_KEY    | https://opencode.ai/zen/v1        |
#   | OpenCode Go           | OPENCODE_API_KEY    | https://opencode.ai/zen/go/v1     |
#
# Model ids per peer (see gen-lib.mjs / generate-peer-cloud.yaml.mjs):
#   - openrouter: live /models, filtered to the ":free" slice.
#   - opencode + opencode-go: the vendored models.dev catalog
#     (models.dev.api.json), ALL models unfiltered — access is decided at
#     request time by the key the peer carries.
#
# --- provider keys ---------------------------------------------------------
# OpenRouter (only the ":free" slice is enumerated).
OPENROUTER_API_KEY=
# ONE unified key for BOTH the Zen and the Go peers — there is no longer a
# Zen/Go split (OPENCODE_ZEN_API_KEY / OPENCODE_GO_API_KEY are ignored, and
# generate.sh warns when it sees them).  See docs/d019.
OPENCODE_API_KEY=

# --- serving ---------------------------------------------------------------
# Listen address for the llama-swap server (read by run.sh / run-native.sh).
LISTEN=:8080
# Bearer auth: the key the client (pi) sends to llama-swap.  This is the key
# 00-general.yaml's `apiKeys` references — today ${env.PEER_API_KEY}, from
# llama-swap-core.json (the older LLAMASWAP_API_KEY name is no longer read by
# the generated config).  Use a long random string; it is the only thing
# standing between the LAN/tailscale FQDN and your provider quota.
PEER_API_KEY=
# Also the auth key used to probe a remote local-inference instance for the
# gfx1030 peer route (generate-gfx1030-models.mjs).  Set PEER_BASE_URL to
# override the probe's tailscale-FQDN candidate.
PEER_BASE_URL=
