{
	"$schema": "https://unpkg.com/knip@6.43.0/schema.json",
	// WHY a hand-maintained entry list: this repo has no bundler and no
	// bin/main field — the "entry points" are whatever the *.sh shims and
	// the pi host actually execute, and only the operator knows that list.
	// Everything NOT listed here is analyzed as a library module reachable
	// only through imports (gen-lib.mjs, git-lib.mjs, the pi-*/ sources and
	// merge modules), which is where unused exports are a real finding.
	//
	// */lib/*.mjs are entries BY CONTRACT, not by reachability: a unit imports
	// its own copy through a computed LIB_DIR dynamic import
	// (await import(`${LIB_DIR}/log.mjs`)), which no static analyzer can
	// follow — treating them as project files would false-positive the whole
	// per-unit surface as unused. Entry status is the honest encoding of "this
	// is a published surface"; their exports are therefore not unused-export
	// candidates. Since docs/d113 replaced the one shared lib/ with per-unit
	// copies, the glob is per folder and the root has no lib at all; the pi
	// extension folders carry no lib/ either, so their folder-root log.mjs is
	// an ordinary project file reached by static import.
	"entry": [
		// each unit's own build entry (docs/d083/d113: there is no root
		// builder or generator any more)
		"estige/build.mjs",
		"coding-agent/build.mjs",
		"llm-local-inference/build.mjs",
		// the coding-agent runner: the folder driver, its two generator
		// children, and the standalone CLIs the shims and run.sh execute
		"coding-agent/generate.mjs",
		"coding-agent/generate-pi-coding-agent.mjs",
		"coding-agent/generate-opencode.mjs",
		"coding-agent/refresh-models-dev.mjs",
		"coding-agent/catalog-facts.mjs",
		"coding-agent/route-probe.mjs",
		"coding-agent/check-canonical-artifacts.mjs",
		// the launcher the run.sh shim executes (run.sh is the operator's
		// entry, so nothing imports run.mjs's main)
		"coding-agent/run.mjs",
		// git/ farm tooling: every script the git/*.sh shims run. The shared
		// floor (lib/git-core.mjs, lib/cli.mjs, …) stays a project file — the
		// entries import it.
		"git/audit.mjs",
		"git/local-changes.mjs",
		"git/maintain-mirrors.mjs",
		"git/migrate-to-bare.mjs",
		"git/forge-mirror.mjs",
		"git/search-references.mjs",
		"git/vbs-har.mjs",
		"git/vbs-mirror-all.mjs",
		"git/farm-tool.mjs",
		"git/farm-aliases.mjs",
		"llm-local-inference/generate.mjs",
		"llm-local-inference/model-sizes.mjs",
		// the pi extension family: each folder's generator (run by that
		// folder's package.json script, via the root ./npm-run.sh) and its
		// runtime entry (loaded by the pi host, which no import graph can
		// see — entry status encodes that contract)
		"pi-cline-pass/generate.mjs",
		"pi-cline-pass/index.ts",
		"pi-synthetic/generate.mjs",
		"pi-synthetic/index.ts",
		"pi-hyper/generate.mjs",
		"pi-hyper/index.ts",
		"pi-verboo/generate.mjs",
		"pi-verboo/index.ts",
		"pi-mistral/index.ts",
		"pi-opencode/index.ts",
		"*/lib/*.mjs",
		// ./test.sh runs every unit's tests, which nothing else imports
		// (docs/d113)
		"*/tests/*.test.mjs",
		// the spec-graph gate ./lint.sh executes (docs/d140): it walks the tree
		// and nothing imports it
		"docs/spec-check.mjs"
	],
	// The pi host package is provided by the runtime environment and is
	// deliberately never a dependency of this repo (tsconfig.json's NOTE).
	// The Go toolchain is a system dependency of estige's build
	// (lib/go-build.mjs shells out to it) — a binary, not an npm package.
	// xdg-user-dir derives the mirrors-dir fallback in git/forge-mirror.mjs and
	// git/lib/farm-posture.mjs's farmRoot(): host state, the same fact the
	// git/*.sh shims read from the xdg config.
	// flock(1) is the farm mutation mutex in both halves of git/ — the shell
	// wrapper that takes it (farm-lock.sh) and the node probe that reports it
	// (lib/farm-lock.mjs); like go, it is a host binary, not an npm package.
	"ignoreBinaries": ["go", "xdg-user-dir", "flock"],
	"ignoreDependencies": ["@earendil-works/pi-coding-agent"]
}
