#!/bin/sh
# LOCAL-INFERENCE ENV — key names consumed by the llama-swap instance that
# serves local GGUFs.
#
# DOCUMENTATION ONLY — NO SCRIPT IN THIS REPO READS THIS FILE.
#
# `load_secrets` (../lib/workload-runtime.sh) is the single source of these
# values, with exactly two inputs: the CALLER'S ENVIRONMENT (keys already
# exported, or SECRETS_ASSUME=1) and Infisical (one in-memory round-trip; the
# dotenv text is only the CLI's wire format, never written to a file).
#
# Cloud provider keys (OPENROUTER_/OPENCODE_/CLINE_/MISTRAL_API_KEY, …) are
# NOT consumed here — cloud relay is served by ../llm-reverse-proxy, whose
# callers must already carry valid provider keys; no keys are read or
# injected anywhere in that path.

# --- serving ---------------------------------------------------------------
# Host port the llama-swap container publishes (default 8101; the container
# always listens on 8080 internally). Host port 8080 belongs to
# ../llm-reverse-proxy — the tailscale funnel front (docs/d027).
HOST_PORT=8101
# Bearer auth: the key the client (pi / opencode) sends to llama-swap. This
# is the key 00-general.yaml's `apiKeys` references — today
# ${env.PEER_API_KEY}, from llama-swap-core.json. Use a long random string;
# it is the only thing standing between the LAN/tailscale FQDN and the local
# GPU.
PEER_API_KEY=

# --- container / model download -------------------------------------------
# Only consumed by launch-gguf.sh (the HF-snapshot resolver's download
# fallback); GGUFs normally come from the host HF hub cache mounted into the
# container.
HF_TOKEN=
