#!/bin/sh
# LOCAL-INFERENCE ENV — key names consumed by the llama-swap instance that
# serves local GGUFs.
#
# DOCUMENTATION ONLY — NO SCRIPT IN THIS REPO READS THIS FILE.
#
# `../environment.sh` (the explicit chain) is the single source of these
# values, with exactly two inputs: the CALLER'S ENVIRONMENT (keys already
# exported) and Infisical (one in-memory `infisical run` round-trip; the
# dotenv text is only the CLI's wire format, never written to a file).
#
# Cloud provider keys (OPENROUTER_/OPENCODE_/CLINE_/MISTRAL_API_KEY, …) are
# NOT consumed here — cloud relay is served by ../estige, whose
# callers must already carry valid provider keys; no keys are read or
# injected anywhere in that path.

# --- serving ---------------------------------------------------------------
# Host port the llama-swap container publishes (default 9292, the port
# upstream llama-swap's own example publishes; the container always listens on
# 8080 internally, docs/d224). Host port 8080 belongs to ../estige — the
# tailscale funnel front (docs/d027).
HOST_PORT=9292
# The tlalocayotl provider row's own key (fact-table id `llama-swap`, the
# provider's former name; earlier still `bazzite`). It is the credential
# pi/opencode send for local models, and the same key 00-general.yaml's
# `apiKeys` makes this instance demand — one provider's key, no cloud row
# uses it. Use a long random string; it is the only thing standing between
# the LAN/tailscale FQDN and the local GPU.
TLALOCAYOTL_API_KEY=

# --- container / model provisioning ----------------------------------------
# NOT consumed by this module anymore: model paths are baked into the generated
# config at generation time (docs/d029 option B) and nothing in-container
# downloads. GGUFs are provisioned on the HOST into the HF hub cache by
# ./40-download-models.py (whose own pipeline consumes HF_TOKEN via
# ../environment.sh).
# HF_TOKEN=
