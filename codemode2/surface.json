{
	"version": 1,
	"$comment": "docs/d194 owns the reasoning; this file is the decided surface the runtime implements and the tests pin.",
	"grants": { "fs.read": "read bytes and metadata under the visible roots", "fs.write": "create, replace, rename and remove entries under the writable roots", "env": "a fixed, non-inherited environment: no PATH, no HOME, no host variables", "clock": "read the runtime clock; timers and sleep are not part of the surface", "net": "withheld — no command reaches a socket, a resolver or a proxy", "exec": "withheld — no command creates a child process and the runtime has no execve path" },
	"posix": [
		{ "command": "cat", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-n", "-b", "-s", "-A", "-E", "-T", "-v" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "head", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-n", "-c", "-q" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "tail", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-n", "-c", "-q" ], "deny": [ "-f", "-F" ], "corpus": [ "file-read" ], "note": "follow mode is a timer, and the surface has none" },
		{ "command": "tac", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "rev", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "nl", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-b", "-n", "-w", "-s" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "wc", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-l", "-w", "-c", "-m", "-L" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "ls", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-1", "-a", "-l", "-R", "-d", "-F", "-h", "-S", "-t", "-r" ], "deny": [], "corpus": [], "note": "absent from the corpus; the owner and group columns render as fixed ids because no passwd database is visible" },
		{ "command": "stat", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-c" ], "deny": [], "corpus": [], "note": "the format string is a fixed field set, not printf" },
		{ "command": "du", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-s", "-h", "-a", "-d", "-c" ], "deny": [], "corpus": [], "note": "absent from the corpus: it reports virtual sizes, not device blocks" },
		{ "command": "find", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-name", "-iname", "-path", "-type", "-size", "-mtime", "-maxdepth", "-mindepth", "-print", "-print0", "-empty", "-not", "-o", "-a" ], "deny": [ "-exec", "-execdir", "-ok", "-okdir", "-delete", "-fprint", "-fprint0", "-fprintf", "-fls", "-printf" ], "corpus": [ "file-read", "file-write", "shell" ], "note": "the action flags are the whole dangerous half; the predicate half is what a search needs" },
		{ "command": "grep", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-i", "-n", "-c", "-l", "-L", "-v", "-w", "-F", "-E", "-r", "-R", "-o", "-m", "-A", "-B", "-C", "-H", "-h", "-s", "-f", "--include", "--exclude", "--exclude-dir" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "sed", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-n", "-e", "-f", "-i" ], "deny": [ "s///e", "s///w", "w", "W", "r", "R", "e", "-s" ], "corpus": [ "file-read", "file-write", "shell" ], "note": "the script is our grammar: a block list without the read and write commands and without the exec flag on s" },
		{ "command": "cut", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-d", "-f", "-c", "-s", "--complement", "--output-delimiter" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "paste", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-d", "-s" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "join", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-t", "-1", "-2", "-a", "-o", "-e" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "comm", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-1", "-2", "-3" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "sort", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-n", "-r", "-u", "-k", "-t", "-f", "-b", "-h", "-V", "-s" ], "deny": [ "-o", "--compress-program" ], "corpus": [ "file-read", "file-write" ], "note": "-o writes a file outside the redirection rule; --compress-program is exec" },
		{ "command": "uniq", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-c", "-d", "-u", "-i", "-f", "-s" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "tr", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-d", "-s", "-c" ], "deny": [], "corpus": [], "note": "absent from the corpus; the set grammar is characters and named classes only, no ranges with -c quirks" },
		{ "command": "expand", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-t" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "fold", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-w", "-s" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "column", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-t", "-s", "-o" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "diff", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-u", "-q", "-r", "-N", "-w", "-B", "-i", "--label" ], "deny": [ "--exclude-program", "-x" ], "corpus": [ "file-read" ] },
		{ "command": "base64", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-d", "-w" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "sha256sum", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-b", "-c", "--quiet", "--status" ], "deny": [], "corpus": [ "file-read" ], "note": "absent from the corpus; the hash itself is not a boundary, the path policy is" },
		{ "command": "jq", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-r", "-c", "-e", "-n", "-S", "-j", "-a", "--arg", "--argjson", "--rawfile", "--slurpfile", "--tab", "--indent", "-f" ], "deny": [ "-L", "--library-path", "include", "import", "module" ], "corpus": [ "file-read" ], "note": "the JSON engine is JS, so the filter language is data access; module loading would be code load" },
		{ "command": "hexdump", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "-C", "-c", "-v", "-n", "-s" ], "deny": [ "-e", "-f" ], "corpus": [ "file-read" ], "note": "-e is a format mini-language with its own conversion specifiers; the fixed formats cover inspection" },
		{ "command": "tee", "strategy": "reimplement", "grants": [ "fs.write" ], "allow": [ "-a" ], "deny": [], "corpus": [ "file-write" ] },
		{ "command": "cp", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-r", "-R", "-n", "-v", "-f" ], "deny": [ "-a", "-p", "--preserve", "-l", "-s", "--link", "--symbolic-link" ], "corpus": [ "file-read", "file-write", "privilege-escalation" ], "note": "preserving mode carries setuid bits and hardlinking crosses the root without a path check" },
		{ "command": "mv", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-n", "-v", "-f" ], "deny": [], "corpus": [ "file-write", "privilege-escalation" ] },
		{ "command": "rm", "strategy": "reimplement", "grants": [ "fs.write" ], "allow": [ "-r", "-R", "-f", "-d", "-v" ], "deny": [], "corpus": [], "note": "absent from the corpus; removal is the write grant the surface already carries" },
		{ "command": "mkdir", "strategy": "reimplement", "grants": [ "fs.write" ], "allow": [ "-p", "-v" ], "deny": [ "-m", "--mode" ], "corpus": [], "note": "no mode argument: the runtime owns the mode, and nothing is executable" },
		{ "command": "rmdir", "strategy": "reimplement", "grants": [ "fs.write" ], "allow": [ "-p" ], "deny": [], "corpus": [] },
		{ "command": "touch", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-c", "-d", "-r", "-a", "-m" ], "deny": [], "corpus": [] },
		{ "command": "truncate", "strategy": "reimplement", "grants": [ "fs.write" ], "allow": [ "-s", "-c", "-r" ], "deny": [], "corpus": [] },
		{ "command": "mktemp", "strategy": "reimplement", "grants": [ "fs.write" ], "allow": [ "-d", "-p", "-t" ], "deny": [], "corpus": [] },
		{ "command": "ln", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-f", "-n", "-v" ], "deny": [ "-s", "--symbolic" ], "corpus": [ "privilege-escalation" ], "note": "a symlink is a path the root check does not follow; the v1 surface has hard links only" },
		{ "command": "split", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-l", "-b", "-a", "-d", "-n" ], "deny": [], "corpus": [ "file-read", "file-write", "shell" ] },
		{ "command": "tar", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-c", "-x", "-t", "-f", "-C", "-z", "-v", "--strip-components", "-O" ], "deny": [ "--to-command", "--use-compress-program", "-I", "-F", "--checkpoint-action", "--rmt-command", "--rsh-command", "--info-script", "-X", "--transform", "-M" ], "corpus": [ "download", "file-read", "file-write", "shell", "upload" ], "note": "two hazards at once: extract paths climb out of the root, and the command flags are exec" },
		{ "command": "gzip", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-d", "-c", "-k", "-1", "-6", "-9", "-l" ], "deny": [ "-S", "--rsyncable" ], "corpus": [ "file-read" ] },
		{ "command": "gunzip", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-c", "-k", "-l" ], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "zcat", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [], "deny": [], "corpus": [ "file-read" ] },
		{ "command": "unzip", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-l", "-o", "-q", "-d", "-x" ], "deny": [ "-P", "-K" ], "corpus": [ "privilege-escalation" ], "note": "entry names are validated after decompression: no absolute path, no .., no symlink or device entry" }
	],
	"windows": [
		{ "command": "type", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [], "deny": [], "categories": [], "note": "a cmd.exe built-in, so no signed binary exists to list; the read it exposes is the one the surface reimplements" },
		{ "command": "more", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "/S" ], "deny": [], "note": "a cmd.exe paging filter, not a pager: no input, no shell escape", "categories": [] },
		{ "command": "findstr", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "/I", "/N", "/C", "/R", "/S", "/M", "/V" ], "deny": [], "categories": [ "ADS", "Credentials", "Download" ] },
		{ "command": "where", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "/R" ], "deny": [], "note": "absent from the corpus; it searches the visible roots, and there is no PATH", "categories": [] },
		{ "command": "dir", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "/A", "/B", "/S", "/O" ], "deny": [], "note": "the corpus row for Cmd covers the alternate-data-stream read; the surface has no stream namespace", "categories": [ "ADS" ] },
		{ "command": "copy", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "/Y", "/B" ], "deny": [ "/A" ], "categories": [ "Copy" ] },
		{ "command": "move", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "/Y" ], "deny": [], "categories": [ "Copy" ] },
		{ "command": "del", "strategy": "reimplement", "grants": [ "fs.write" ], "allow": [ "/F", "/Q", "/S" ], "deny": [], "categories": [] },
		{ "command": "ren", "strategy": "reimplement", "grants": [ "fs.write" ], "allow": [], "deny": [], "categories": [] },
		{ "command": "md", "strategy": "reimplement", "grants": [ "fs.write" ], "allow": [], "deny": [], "categories": [] },
		{ "command": "rd", "strategy": "reimplement", "grants": [ "fs.write" ], "allow": [ "/S", "/Q" ], "deny": [], "categories": [] },
		{ "command": "sort", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "/R", "/N" ], "deny": [], "categories": [] },
		{ "command": "fc", "strategy": "reimplement", "grants": [ "fs.read" ], "allow": [ "/N", "/C", "/L", "/B" ], "deny": [], "categories": [] },
		{ "command": "tar", "strategy": "reimplement", "grants": [ "fs.read", "fs.write" ], "allow": [ "-c", "-x", "-t", "-f", "-C" ], "deny": [], "note": "the Windows archiver is in the corpus for copy and stream writes, not for exec; extraction keeps the POSIX validation", "categories": [ "ADS", "Copy" ] }
	],
	"denied": [
		{ "os": "posix", "family": [ "sh", "bash", "dash", "ash", "zsh", "ksh", "mksh", "csh", "tcsh", "fish", "rc", "elvish", "yash", "sash", "posh", "rbash", "busybox", "toybox" ], "reason": "a shell is the primitive the surface exists to remove; a multiplexer that inherits every applet is the same primitive in a smaller binary" },
		{ "os": "posix", "family": [ "awk", "gawk", "mawk", "nawk", "perl", "python", "python3", "ruby", "node", "deno", "bun", "lua", "php", "tclsh", "wish", "expect", "js", "js-exec", "dotnet", "java", "jshell", "jrunscript", "jjs", "R", "octave", "guile", "clisp", "ghci", "irb", "pry", "csi", "fsi", "byebug", "pdb" ], "reason": "a language runtime is exec by construction: the corpus lists shell and file-write for nearly every interpreter, and no filter over its syntax is verifiable" },
		{ "os": "posix", "family": [ "vi", "vim", "nvim", "view", "vview", "rview", "rvim", "vimdiff", "nano", "pico", "emacs", "ed", "ex", "joe", "less", "more", "man", "info", "yelp", "zathura", "ranger", "fzf", "tmux", "screen", "script", "scriptreplay" ], "reason": "editors, pagers and terminal multiplexers all reach a shell or a loader from a keystroke or an escape, and none of them is needed once editing is a declared tool" },
		{ "os": "posix", "family": [ "env", "nice", "nohup", "timeout", "stdbuf", "time", "watch", "flock", "setarch", "taskset", "chrt", "ionice", "xargs", "parallel", "start-stop-daemon", "setsid", "run-parts", "multitime", "setlock", "softlimit", "cpulimit", "lsns", "nsenter", "unshare", "chroot", "firejail" ], "reason": "these translate their own argv into a child process; a wrapper in the command table is an exec flag with extra steps" },
		{ "os": "posix", "family": [ "su", "sudo", "doas", "pkexec", "ksu", "login", "sulogin", "passwd", "newgrp", "sg", "chsh", "chfn", "gpasswd", "chmod", "chown", "chgrp", "chattr", "setcap", "getcap", "setfacl", "getfacl", "mount", "umount", "swapon", "pivot_root", "switch_root", "unix_chkpwd" ], "reason": "the privilege boundary: the runtime runs unprivileged, so a mode or ownership change is either inert or an escalation, and neither is a tool capability" },
		{ "os": "posix", "family": [ "curl", "wget", "nc", "ncat", "socat", "ssh", "scp", "sftp", "rsync", "telnet", "ftp", "tftp", "lftp", "sshfs", "sshpass", "ssh-keygen", "ssh-agent", "ssh-keyscan", "ssh-copy-id", "aria2c", "mosh-server", "tcpserver", "tmate", "ping", "dig", "nslookup", "whois", "host", "ip", "ss", "netstat", "nmap", "hping3", "tcpdump", "wireshark", "tshark" ], "reason": "egress is a chain step of its own (docs/d127); a command table that dials is a proxy with no policy" },
		{ "os": "posix", "family": [ "systemctl", "service", "systemd-run", "systemd-resolve", "crontab", "at", "batch", "journalctl", "dmesg", "sysctl", "loginctl", "timedatectl", "hostnamectl", "reboot", "shutdown", "kill", "killall", "pkill", "renice", "nice" ], "reason": "host state and other processes: the runtime has no pid to signal and no unit to start" },
		{ "os": "posix", "family": [ "make", "cmake", "ninja", "gcc", "cc", "g++", "clang", "ld", "as", "ar", "gdb", "strace", "ltrace", "bpftrace", "perf", "valgrind", "cargo", "rustc", "go", "npm", "pnpm", "yarn", "pip", "pipx", "uv", "poetry", "git", "hg", "svn", "terraform", "ansible-playbook" ], "reason": "build systems and toolchains turn source into a process, and git's hooks, pagers and aliases do the same" },
		{ "os": "posix", "family": [ "docker", "podman", "kubectl", "lxc", "lxd", "virsh", "qemu-system-x86_64", "nsenter", "ctr", "crictl", "sqlite3", "mysql", "psql", "redis-cli", "mongo", "gcloud", "aws", "az" ], "reason": "control-plane clients: each is a broker to something outside the sandbox, which is the escape with a friendly name" },
		{ "os": "posix", "family": [ "dd", "shred", "wipe", "unsquashfs", "mksquashfs", "genisoimage", "mkfs", "fdisk", "sfdisk", "parted", "fsck", "losetup", "dmsetup", "lvm", "mdadm", "debugfs", "mount" ], "reason": "block and device paths: the virtual filesystem has no device node, and a tool that wants one is out of scope" },
		{ "os": "posix", "family": [ "zip", "p7zip", "7z", "arj", "cpio", "pax", "zstd", "xz", "bzip2", "lz4", "rar", "unrar" ], "reason": "archive families whose writers carry a command or a stream-restore hook (7z -so, cpio --to-stdout, zip --unzip-command); gzip, tar and unzip cover the workflow" },
		{ "os": "windows", "family": [ "cmd", "cmd.exe", "powershell", "powershell.exe", "pwsh", "wmic", "mshta", "rundll32", "regsvr32", "regasm", "regsvcs", "msiexec", "installutil", "odbcconf", "forfiles", "mavinject", "cscript", "wscript", "msbuild", "csc", "jsc", "vbc", "ilasm", "ngen", "aspnet_compiler", "wsl", "bash.exe", "conhost", "cdb", "windbg", "dump64", "procdump", "comsvcs", "sqldumper", "ntdsutil", "diskshadow", "vssadmin", "wbadmin", "bcdedit", "reg", "regedit", "regini", "sc", "net", "net1", "netsh", "schtasks", "at", "atbroker", "query", "quser", "pktmon", "psr", "mmc", "control", "eventvwr", "wsreset", "computerdefaults", "odbcad32", "verclsid", "pcalua", "pcwrun", "runexehelper", "scriptrunner", "setupugc", "xwizard", "certutil", "bitsadmin", "certoc", "certreq", "desktopimgdownldr", "ftp", "tftp", "curl", "ssh", "scp", "sftp", "winget", "makecab", "expand.exe", "extrac32", "printbrm", "esentutl", "ldifde", "msdeploy", "xcopy", "robocopy", "replace" ], "reason": "the Windows half of the corpus: 161 of its 248 entries reach Execute, and the ones that do not reach a shell or a loader through a script host, a registry autostart or a stream write — so the Windows surface is reimplemented and creates no process at all" }
	]
}
