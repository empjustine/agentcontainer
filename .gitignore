# Build outputs of the estige unit — build.mjs resolves these inside the
# folder (estige-android preferred on Termux), never from git; the packaged
# artifacts under estige/packaging/out/ are ignored by that folder's own file.
estige/estige
estige/estige-android

# npm dev tooling (docs/d107) — package-lock.json is the tracked lock; the
# installed tree is disposable and recreated on demand by ./npm-tools.sh.
node_modules/

# Python bytecode — the llm-local-inference tools run through `uv run`, which
# writes __pycache__ beside every imported module (the unit's own lib/
# included). Disposable by definition: no .pyc is ever an input.
__pycache__/

# The gate's python environment (lint.sh's `uv sync --frozen` from
# pyproject.toml + uv.lock) — node_modules' twin: disposable, rebuilt on
# demand, never tracked. uv.lock IS tracked (the package-lock.json analog).
.venv/

# A harness (mise) writes this beside the caller on first use. d051/d082 keep mise
# out of every runtime path and d137 forbids committing a root file: one re-pins
# bare `node`/`go` for anything entering the tree (docs/architecture.md).
mise.toml
