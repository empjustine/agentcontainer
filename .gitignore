# Build outputs of the estige unit — build.mjs resolves these inside the
# folder (estige-android preferred on Termux), never from git; the packaged
# artifacts under estige/packaging/out/ are ignored by that folder's own file.
estige/estige
estige/estige-android

# npm dev tooling (docs/d107) — package-lock.json is the tracked lock; the
# installed tree is disposable and recreated on demand by ./npm-tools.sh.
node_modules/
