// Type-checking config for the JSDoc-typed scripts. The types themselves live
// in the code (JSDoc next to the functions they describe) — this file only
// points `tsc` at the files that carry them and sets the strictness. Add a
// script to `include` once it carries JSDoc types; scripts without them are
// left out on purpose so the checker stays a gate instead of a backlog.
//
// Run it with ./check-types.sh (typescript + @types/node are root
// devDependencies pinned by package-lock.json — docs/d107).
{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		// package.json's devDependencies are the JS gate pins (docs/d107); it
		// has no runtime dependencies. moduleDetection stays "force" so tsc
		// never leans on manifest discovery for what is ESM.
		"moduleDetection": "force",
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		// The zero-finding strictness flags (surveyed 2026-10-30: each produces
		// zero diagnostics over the whole include list, so enabling them changed
		// nothing the day they landed — the tsc half of the strictness free
		// wave; the finding-carrying flags land as their own fix-and-enable
		// waves, one commit per flag):
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"verbatimModuleSyntax": true,
		"noUncheckedSideEffectImports": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		// The finding wave (24 sites, fixed): optional slots that DELIBERATELY
		// receive undefined ("the source did not publish this") are now typed
		// T|undefined; fetch headers became conditional spreads; test override
		// helpers take mapped types that allow explicit undefined.
		"exactOptionalPropertyTypes": true,
		// The strictness program is COMPLETE (waves v23.22-v23.27): every file
		// below carries noUncheckedIndexedAccess, so the tsconfig.strict.json
		// overlay was folded back here and deleted — one config, one gate run.
		"noUncheckedIndexedAccess": true,
		// SURVEYED AND REJECTED — noPropertyAccessFromIndexSignature: all 193
		// findings are process.env dot reads; the flag demands bracket access
		// for zero typo-safety (an index signature accepts any string either
		// way), against the d001 env-surface convention, and in direct conflict
		// with biome's useLiteralKeys (error level), which demands the opposite.
		// noUncheckedIndexedAccess lands as its own overlay waves (see the
		// commit log for the wave order).
		"skipLibCheck": true
	},
	"include": [
		// The per-unit lib/ copies (docs/d113 folded the one shared lib/ into
		// the folders that consume it), plus each unit's own build entry —
		// there is no root build.mjs or generate.mjs any more. The pi
		// extension folders carry no lib/ at all: their logger sits at the
		// folder root, imported statically by the folder's own modules.
		"*/lib/*.mjs",
		"pi-*/log.mjs",
		"estige/build.mjs",
		"coding-agent/build.mjs",
		"llm-local-inference/build.mjs",
		"git/tests/git-glob.test.mjs",
		"git/tests/git-pacer.test.mjs",
		"git/tests/git-cli.test.mjs",
		"git/tests/git-retry.test.mjs",
		"git/tests/git-farm-lock.test.mjs",
		"git/tests/git-vbs-mirror.test.mjs",
		"git/audit.mjs",
		"git/local-changes.mjs",
		"git/migrate-to-bare.mjs",
		"git/maintain-mirrors.mjs",
		"git/forge-mirror.mjs",
		"git/search-references.mjs",
		"git/vbs-har.mjs",
		"git/vbs-mirror-all.mjs",
		"pi-synthetic/sources.mjs",
		"pi-synthetic/merge.mjs",
		"pi-synthetic/generate.mjs",
		"pi-cline-pass/sources.mjs",
		"pi-cline-pass/merge.mjs",
		"pi-cline-pass/generate.mjs",
		"pi-hyper/sources.mjs",
		"pi-hyper/merge.mjs",
		"pi-hyper/generate.mjs",
		"pi-verboo/sources.mjs",
		"pi-verboo/merge.mjs",
		"pi-verboo/generate.mjs",
		// Every test lives with the code it tests (docs/d113) — the repo root
		// has no tests/ folder.
		"coding-agent/tests/committed-manifests.test.mjs",
		"coding-agent/tests/canonical-json.test.mjs",
		"coding-agent/tests/fact-table.test.mjs",
		"coding-agent/tests/artifact-urls.test.mjs",
		"coding-agent/tests/modality-allowlist.test.mjs",
		"coding-agent/tests/pi-cost.test.mjs",
		"pi-synthetic/tests/pi-synthetic.test.mjs",
		"pi-cline-pass/tests/pi-cline-pass.test.mjs",
		"pi-opencode/tests/pi-opencode.test.mjs",
		"pi-hyper/tests/pi-hyper.test.mjs",
		"pi-verboo/tests/pi-verboo.test.mjs",
		"pi-mistral/tests/pi-mistral.test.mjs",
		"llm-local-inference/generate.mjs",
		"llm-local-inference/model-sizes.mjs",
		"coding-agent/run.mjs",
		"coding-agent/tests/check-workload.test.mjs",
		"coding-agent/tests/check-run-dirs.test.mjs",
		"coding-agent/tests/jq-free.test.mjs",
		"coding-agent/route-probe.mjs",
		"coding-agent/check-canonical-artifacts.mjs",
		"coding-agent/catalog-facts.mjs",
		"coding-agent/refresh-models-dev.mjs",
		"coding-agent/gen-lib.mjs",
		"coding-agent/generate-pi-coding-agent.mjs",
		"coding-agent/generate-opencode.mjs",
		"coding-agent/generate.mjs"
		// NOTE: the extension entries (pi-synthetic/index.ts,
		// pi-cline-pass/index.ts, pi-hyper/index.ts, pi-verboo/index.ts,
		// pi-mistral/index.ts, pi-opencode/index.ts) are deliberately
		// NOT listed. They import
		// @earendil-works/pi-coding-agent, which this repo does not vendor, so
		// tsc would report one missing module that is host-provided at runtime.
		// They are covered better by their <folder>/tests/*.test.mjs files,
		// which IMPORT AND RUN the real entry points.
	]
}
