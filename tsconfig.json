// Type-checking config for the JSDoc-typed scripts. The types themselves live
// in the code (JSDoc next to the functions they describe) — this file only
// points `tsc` at the files that carry them and sets the strictness. Add a
// script to `include` once it carries JSDoc types; scripts without them are
// left out on purpose so the checker stays a gate instead of a backlog.
//
// Run it with ./check-types.sh (typescript + @types/node are provisioned ad
// hoc — no pinned dev deps, same as lint.sh).
{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		// The root package.json is a MINIMAL, dependency-free manifest (knip's
		// gate requirement, plus an explicit "type": "module" for the .js
		// seeds that Node previously handled by syntax detection). It must
		// stay dependency-free: the repo's tools are provisioned ad hoc
		// (lint.sh/check-types.sh), never through it. moduleDetection stays
		// "force" so tsc never leans on manifest discovery for what is ESM.
		"moduleDetection": "force",
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		// The zero-finding strictness flags (surveyed 2026-10-30: each produces
		// zero diagnostics over the whole include list, so enabling them changed
		// nothing the day they landed — the tsc half of the strictness free
		// wave; the finding-carrying flags land as their own fix-and-enable
		// waves, one commit per flag):
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"verbatimModuleSyntax": true,
		"noUncheckedSideEffectImports": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		// The finding wave (24 sites, fixed): optional slots that DELIBERATELY
		// receive undefined ("the source did not publish this") are now typed
		// T|undefined; fetch headers became conditional spreads; test override
		// helpers take mapped types that allow explicit undefined.
		"exactOptionalPropertyTypes": true,
		// SURVEYED AND REJECTED — noPropertyAccessFromIndexSignature: all 193
		// findings are process.env dot reads; the flag demands bracket access
		// for zero typo-safety (an index signature accepts any string either
		// way), against the d001 env-surface convention, and in direct conflict
		// with biome's useLiteralKeys (error level), which demands the opposite.
		// noUncheckedIndexedAccess lands as its own overlay waves (see the
		// commit log for the wave order).
		"skipLibCheck": true
	},
	"include": [
		"lib/artifact.mjs",
		"lib/canonical-json.mjs",
		"lib/cloud-providers.mjs",
		"lib/go-build.mjs",
		"lib/host-capabilities.mjs",
		"lib/log.mjs",
		"tests/canonical-json.test.mjs",
		"tests/git-glob.test.mjs",
		"tests/git-pacer.test.mjs",
		"tests/artifact-urls.test.mjs",
		"tests/modality-allowlist.test.mjs",
		"tests/pi-cost.test.mjs",
		"generate.mjs",
		"build.mjs",
		"coding-agent/route-probe.mjs",
		"coding-agent/check-routed-artifacts.mjs",
		"coding-agent/catalog-facts.mjs",
		"coding-agent/refresh-models-dev.mjs",
		"coding-agent/gen-lib.mjs",
		"coding-agent/generate-pi-coding-agent.mjs",
		"coding-agent/generate-opencode.mjs",
		"git/git-lib.mjs",
		"git/audit.mjs",
		"git/local-changes.mjs",
		"git/migrate-to-bare.mjs",
		"git/maintain-mirrors.mjs",
		"git/forge-mirror.mjs",
		"git/software-forge-remotes.mjs",
		"git/search-references.mjs",
		"git/vbs-har.mjs",
		"coding-agent/generate.mjs",
		"llm-local-inference/generate.mjs",
		"llm-local-inference/model-sizes.mjs",
		"llm-reverse-proxy/generate.mjs",
		"pi-synthetic/sources.mjs",
		"pi-synthetic/merge.mjs",
		"pi-synthetic/generate.mjs",
		"tests/pi-synthetic.test.mjs",
		"pi-cline-pass/sources.mjs",
		"pi-cline-pass/merge.mjs",
		"pi-cline-pass/generate.mjs",
		"tests/pi-cline-pass.test.mjs",
		"tests/pi-opencode.test.mjs",
		"pi-hyper/sources.mjs",
		"pi-hyper/merge.mjs",
		"pi-hyper/generate.mjs",
		"tests/pi-hyper.test.mjs",
		"pi-verboo/sources.mjs",
		"pi-verboo/merge.mjs",
		"pi-verboo/generate.mjs",
		"tests/pi-verboo.test.mjs",
		"tests/pi-mistral.test.mjs"
		// NOTE: the extension entries (pi-synthetic/index.ts,
		// pi-cline-pass/index.ts, pi-hyper/index.ts, pi-verboo/index.ts,
		// pi-mistral/index.ts, pi-opencode/index.ts) are deliberately
		// NOT listed. They import
		// @earendil-works/pi-coding-agent, which this repo does not vendor, so
		// tsc would report one missing module that is host-provided at runtime.
		// They are covered better by their tests/*.test.mjs files, which IMPORT
		// AND RUN the real entry points.
	]
}
