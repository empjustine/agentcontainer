// Type-checking config for the JSDoc-typed scripts. The types themselves live
// in the code (JSDoc next to the functions they describe) — this file sets
// the strictness and points `tsc` at the whole tree: the coverage wave
// (2026-11-05) replaced the curated include list with globs, so a file
// joins the gate by existing, not by being listed. The two exclusions are
// contracts (node_modules; the host-provided pi-*/index.ts), documented
// beside the include, not backlog.
//
// Run it with ./check-types.sh (typescript + @types/node are root
// devDependencies pinned by package-lock.json — docs/d107).
{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		// package.json's devDependencies are the JS gate pins (docs/d107); it
		// has no runtime dependencies. moduleDetection stays "force" so tsc
		// never leans on manifest discovery for what is ESM.
		"moduleDetection": "force",
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		// The zero-finding strictness flags (surveyed 2026-10-30; the second
		// wave measured 2026-11-05: each produces zero diagnostics over the
		// whole include list, so enabling them changed nothing the day they
		// landed — the tsc half of the strictness free wave; the
		// finding-carrying flags land as their own fix-and-enable waves, one
		// commit per flag):
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"verbatimModuleSyntax": true,
		"noUncheckedSideEffectImports": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		// Second free wave (2026-11-05): all measured at zero findings. The
		// first three flip tsc's lenient defaults (undefined = no check) to
		// enforced checks; skipLibCheck inverts its old true — @types/node
		// 24.19.2 under TS 6.0.3 type-checks clean, so full .d.ts checking
		// now costs nothing and buys the whole installed type surface.
		"allowUnreachableCode": false,
		"allowUnusedLabels": false,
		"isolatedModules": true,
		"skipLibCheck": false,
		// The finding wave (24 sites, fixed): optional slots that DELIBERATELY
		// receive undefined ("the source did not publish this") are now typed
		// T|undefined; fetch headers became conditional spreads; test override
		// helpers take mapped types that allow explicit undefined.
		"exactOptionalPropertyTypes": true,
		// The strictness program is COMPLETE (waves v23.22-v23.27): every file
		// below carries noUncheckedIndexedAccess, so the tsconfig.strict.json
		// overlay was folded back here and deleted — one config, one gate run.
		"noUncheckedIndexedAccess": true,
		// SURVEYED AND REJECTED — noPropertyAccessFromIndexSignature: all 193
		// findings are process.env dot reads; the flag demands bracket access
		// for zero typo-safety (an index signature accepts any string either
		// way), against the d001 env-surface convention, and in direct conflict
		// with biome's useLiteralKeys (error level), which demands the opposite.
	},
	"include": ["**/*.mjs", "**/*.ts", "**/*.mts", "**/*.js"],
	// Exclusions are contracts, not backlog. node_modules: third-party code
	// pinned by package-lock (docs/d107), checked by the tools' own gates.
	// pi-*/index.ts (the six extension entry points): they import
	// @earendil-works/pi-coding-agent, which this repo does not vendor, so
	// tsc would report a module that is host-provided at runtime; their
	// <folder>/tests/*.test.mjs files IMPORT AND RUN the real entry points
	// instead, which covers them better.
	"exclude": ["node_modules", "**/node_modules", "pi-*/index.ts"]
}
