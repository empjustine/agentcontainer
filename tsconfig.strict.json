{
	// The noUncheckedIndexedAccess overlay — the flag lands here FIRST, one
	// directory wave at a time, and a file "graduates" by MOVING here from
	// tsconfig.json's include list (never by suppression). When the last wave
	// (tests/) lands, this file folds back into tsconfig.json and disappears.
	// check-types.sh runs BOTH configs; each must pass.
	//
	// Wave 1 (v23.22): the pi extension family's own source files.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noUncheckedIndexedAccess": true
	},
	"include": [
		"pi-cline-pass/sources.mjs",
		"pi-cline-pass/merge.mjs",
		"pi-cline-pass/generate.mjs",
		"pi-synthetic/sources.mjs",
		"pi-synthetic/merge.mjs",
		"pi-synthetic/generate.mjs",
		"pi-hyper/sources.mjs",
		"pi-hyper/merge.mjs",
		"pi-hyper/generate.mjs",
		"pi-verboo/sources.mjs",
		"pi-verboo/merge.mjs",
		"pi-verboo/generate.mjs",
		// Wave 2 (v23.23): the local-inference generator pair — the shard-regex
		// groups now flow through one narrowing helper instead of bare indexes.
		"llm-local-inference/generate.mjs",
		"llm-local-inference/model-sizes.mjs",
		// Wave 3 (v23.24): the whole coding-agent folder — the fact-table row
		// lookups now go through providerFacts() (the table's own loud refusal),
		// and the drivable core is a named constant instead of a bare [0].
		"coding-agent/route-probe.mjs",
		"coding-agent/check-routed-artifacts.mjs",
		"coding-agent/catalog-facts.mjs",
		"coding-agent/refresh-models-dev.mjs",
		"coding-agent/gen-lib.mjs",
		"coding-agent/generate-pi-coding-agent.mjs",
		"coding-agent/generate-opencode.mjs",
		"coding-agent/generate.mjs",
		// Wave 4 (v23.25): every non-git test file. The git-* tests stay in the
		// base config with the git/ folder itself — that wave belongs to the
		// concurrent d099 session, and graduating them would drag git-lib into
		// this program via their imports.
		"tests/canonical-json.test.mjs",
		"tests/artifact-urls.test.mjs",
		"tests/modality-allowlist.test.mjs",
		"tests/pi-cost.test.mjs",
		"tests/pi-synthetic.test.mjs",
		"tests/pi-cline-pass.test.mjs",
		"tests/pi-opencode.test.mjs",
		"tests/pi-hyper.test.mjs",
		"tests/pi-verboo.test.mjs",
		"tests/pi-mistral.test.mjs"
	]
}
